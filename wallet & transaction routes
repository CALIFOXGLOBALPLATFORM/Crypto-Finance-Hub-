// src/routes/wallet.ts
import { Router } from 'express';
import { PrismaClient } from '@prisma/client';

const router = Router();
const prisma = new PrismaClient();

// 🔹 Create crypto deposit
router.post('/crypto/deposit', async (req, res) => {
  const { userId, amount, currency, txHash } = req.body;
  try {
    const transaction = await prisma.transaction.create({
      data: {
        userId,
        type: 'DEPOSIT',
        amount,
        status: 'PENDING',
        reason: `Crypto deposit initiated (${currency})`,
      },
    });

    // Audit log
    await prisma.auditLog.create({
      data: {
        userId,
        action: 'CRYPTO_DEPOSIT',
        reason: `TxHash: ${txHash}`,
        newValue: JSON.stringify(transaction),
      },
    });

    res.json({ message: 'Crypto deposit submitted', transaction });
  } catch (err) {
    res.status(400).json({ error: 'Failed to create deposit', details: err });
  }
});

